# ─────────────────────────────────────────────────────────────────────────────
# Inference Server — environment variables
# Copy to project root .env (or export before starting the server)
# ─────────────────────────────────────────────────────────────────────────────

# ── Model ──────────────────────────────────────────────────────────────────
# Which XGBoost model to load at startup.
# Available: v0 (ACC only, 16 feat)  |  v3 (ACC+BARO, 20 feat) [recommended]
#            v0_lsb_int  |  v5_lsb
MODEL_VERSION=v3

# ── Hardware / sensor ───────────────────────────────────────────────────────
# Physical sample rate of the accelerometer (Hz).
# The server resamples to 50 Hz for the model.
HARDWARE_ACC_SAMPLE_RATE=25

# Sensor type — selects which InfluxDB field names to expect in the payload.
# bosch     → bosch_acc_x / y / z
# non_bosch → acc_x / y / z
ACC_SENSOR_TYPE=bosch

# Resampling algorithm used when hardware rate ≠ 50 Hz.
# Options: linear (upsample)  |  decimate  |  average  (downsample)
RESAMPLING_METHOD=linear

# ── Security ────────────────────────────────────────────────────────────────
# Set to true to require X-API-Key on /predict and /model/switch.
PUBLIC_ENDPOINT_ENABLED=true

# Comma-separated list of accepted API keys.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=change_me_before_deploying

# Requests per minute per IP before 429 is returned.
RATE_LIMIT_PER_MINUTE=60

# CORS: * for any origin, or comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=*

# ── Server ──────────────────────────────────────────────────────────────────
SERVER_PORT=8001
