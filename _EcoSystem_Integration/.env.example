# =============================================================================
# _EcoSystem_Integration — single .env for BOTH server and client
#
# IMPORTANT: always run both components from _EcoSystem_Integration/ as cwd:
#   cd _EcoSystem_Integration
#   uvicorn inference_server.server:app --host 0.0.0.0 --port 8001
#   python -m trigger_client.client
#
# load_dotenv() in config/settings.py reads whichever .env is in the cwd.
# Both components share this file — that is intentional.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY  (server reads API_KEYS · client reads REMOTE_API_KEY)
# Both values must be identical — the client sends REMOTE_API_KEY as the
# X-API-Key header, and the server validates it against API_KEYS.
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_ENDPOINT_ENABLED=true                # SERVER — enable API key enforcement
API_KEYS=YOUR_API_KEYS_HERE                 # SERVER
REMOTE_API_KEY=YOUR_REMOTE_API_KEY_HERE     # CLIENT

# ─────────────────────────────────────────────────────────────────────────────
# SERVER ADDRESS  (server reads SERVER_PORT · client reads REMOTE_SERVER_URL)
# ─────────────────────────────────────────────────────────────────────────────
SERVER_PORT=8001                      # SERVER — port uvicorn binds to
REMOTE_SERVER_URL=http://localhost:8001  # CLIENT — where to POST /predict

# ─────────────────────────────────────────────────────────────────────────────
# MODEL  (server reads MODEL_VERSION for default + preload · client reads
#         MODEL_VERSION and sends it in every /predict request so the server
#         uses that model for THIS request regardless of its own default)
#
# Available: v0 (ACC only, 16 feat) | v3 (ACC+BARO, 20 feat) [recommended]
#            v0_lsb_int             | v5_lsb
#
# The client also queries GET /model/info?version=<MODEL_VERSION> on startup
# to determine whether barometer data should be fetched from InfluxDB.
# Setting MODEL_VERSION=v3 here therefore automatically enables baro fetching.
# ─────────────────────────────────────────────────────────────────────────────
MODEL_VERSION=v0                      # SERVER (default) + CLIENT (per-request)
PRELOAD_ALL_MODELS=true               # SERVER — load all .pkl files at startup
                                      #          prevents cold-load delay on first request

# ─────────────────────────────────────────────────────────────────────────────
# HARDWARE / SENSOR  (server reads for preprocessing defaults · client reads
#                     to build the correct InfluxDB query field names and to
#                     include sample_rate in the /predict payload)
# ─────────────────────────────────────────────────────────────────────────────
HARDWARE_ACC_SAMPLE_RATE=25           # SERVER + CLIENT — physical Hz of sensor
ACC_SENSOR_TYPE=bosch                 # SERVER + CLIENT — bosch → bosch_acc_x/y/z
                                      #                   non_bosch → acc_x/y/z
RESAMPLING_METHOD=linear              # SERVER — how to resample to 50 Hz

# ─────────────────────────────────────────────────────────────────────────────
# INFLUXDB  (client only — server never touches InfluxDB)
# ─────────────────────────────────────────────────────────────────────────────
INFLUXDB_URL=YOUR_URL_HERE                            # CLIENT
INFLUXDB_TOKEN=YOUR_TOKEN_HERE                        # CLIENT
INFLUXDB_ORG=YOUR_ORG_HERE                            # CLIENT
INFLUXDB_BUCKET=YOUR_BUCKET_HERE                      # CLIENT

# ─────────────────────────────────────────────────────────────────────────────
# POLLING  (client only)
# ─────────────────────────────────────────────────────────────────────────────
MONITORING_INTERVAL_SECONDS=5         # CLIENT — how often to query InfluxDB
MONITORING_LOOKBACK_SECONDS=15        # CLIENT — how far back each query fetches

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60              # SERVER — max requests per IP per minute
CORS_ALLOWED_ORIGINS=*               # SERVER — allowed CORS origins
# PARTICIPANT_ID=device_001           # CLIENT — forwarded as participant field