# =============================================================================
# _EcoSystem_Integration — single .env for BOTH server and client
#
# Place this file as .env in the _EcoSystem_Integration/ root directory.
# Both components read from this one file via load_dotenv().
#
# IMPORTANT: Always run both components from _EcoSystem_Integration/ as the
# working directory:
#   cd _EcoSystem_Integration
#   uvicorn inference_server.server:app --host 0.0.0.0 --port 8001
#   python -m trigger_client.client
# =============================================================================

# ── API security (must match on BOTH server and client) ─────────────────────
# Server checks incoming X-API-Key against API_KEYS.
# Client sends REMOTE_API_KEY as the X-API-Key header.
# Set them to the same value.
#
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
PUBLIC_ENDPOINT_ENABLED=true
API_KEYS=ae7e8a6b1c7bc35bc8560b65d81bfea68aaa3bc41c7aa0982a4765fb41224848
REMOTE_API_KEY=ae7e8a6b1c7bc35bc8560b65d81bfea68aaa3bc41c7aa0982a4765fb41224848

# ── Inference server ─────────────────────────────────────────────────────────
REMOTE_SERVER_URL=http://localhost:8001
SERVER_PORT=8001

# ── Model ────────────────────────────────────────────────────────────────────
# v0 = ACC only (16 features)   v3 = ACC + barometer (20 features, recommended)
MODEL_VERSION=v0

# ── Hardware / sensor ────────────────────────────────────────────────────────
HARDWARE_ACC_SAMPLE_RATE=25
ACC_SENSOR_TYPE=bosch
RESAMPLING_METHOD=linear

# ── InfluxDB ─────────────────────────────────────────────────────────────────
INFLUXDB_URL=https://ecosystem-influxdb.smarko-health.de
INFLUXDB_TOKEN=v3vG3RliwQKPhUCYmlu4GAjrQcf0uITn_J2E08FaJdpn1-rNU5j0lSX9Cp9VNKw4i9fRjB6cvSO-euuG5IOnWg==
INFLUXDB_ORG=MCS Datalabs GmbH
INFLUXDB_BUCKET=fd_test

# ── Polling ──────────────────────────────────────────────────────────────────
MONITORING_INTERVAL_SECONDS=5
MONITORING_LOOKBACK_SECONDS=15

# ── Optional ─────────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*
# PARTICIPANT_ID=device_001
