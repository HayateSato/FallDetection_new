# ─────────────────────────────────────────────────────────────────────────────
# Trigger Client — environment variables
# Copy to project root .env (or export before starting the client)
# ─────────────────────────────────────────────────────────────────────────────

# ── Inference server ────────────────────────────────────────────────────────
# Base URL of the inference server (no trailing slash).
REMOTE_SERVER_URL=http://localhost:8001

# Must match one of the API_KEYS set on the inference server.
REMOTE_API_KEY=change_me_before_deploying

# ── InfluxDB ────────────────────────────────────────────────────────────────
INFLUXDB_URL=https://your-influxdb-cloud-url
INFLUXDB_TOKEN=your_token_here
INFLUXDB_ORG=your_org_here
INFLUXDB_BUCKET=your_bucket_here

# ── Sensor hardware ─────────────────────────────────────────────────────────
# Must match the physical sensor (forwarded to inference server in the payload).
HARDWARE_ACC_SAMPLE_RATE=25

# bosch → reads bosch_acc_x/y/z from InfluxDB
# non_bosch → reads acc_x/y/z from InfluxDB
ACC_SENSOR_TYPE=bosch

# ── Polling / window ────────────────────────────────────────────────────────
# How often (seconds) the client wakes up and queries InfluxDB.
MONITORING_INTERVAL_SECONDS=5

# How far back (seconds) to fetch data from InfluxDB each cycle.
MONITORING_LOOKBACK_SECONDS=15

# ── Optional ────────────────────────────────────────────────────────────────
# Forwarded to the server as the "participant" field (useful for multi-device).
# PARTICIPANT_ID=device_001
