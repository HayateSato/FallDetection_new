# =============================================================================
# Fall Detection — Caregiver Layer Environment Variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRES (participant_session)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=fall_pass

# -----------------------------------------------------------------------------
# INFLUXDB — external instance (NOT hosted in this compose stack)
#
# Local testing : use MCS cloud InfluxDB (same credentials as the root .env)
# Production    : use FOCUS's own InfluxDB running in their k3s cluster
#
# Used by both mock-app (read ACC + write fall_events) and
# fall-dashboard (read fall_events for /api/falls).
# -----------------------------------------------------------------------------
INFLUXDB_URL=https://ecosystem-influxdb.smarko-health.de
INFLUXDB_TOKEN=v3vG3RliwQKPhUCYmlu4GAjrQcf0uITn_J2E08FaJdpn1-rNU5j0lSX9Cp9VNKw4i9fRjB6cvSO-euuG5IOnWg==
INFLUXDB_ORG=MCS Datalabs GmbH
INFLUXDB_BUCKET=fd_test                  # bucket for reading raw ACC sensor data
INFLUXDB_FALL_EVENTS_BUCKET=fd_test      # bucket for writing/reading fall_events
BAROMETER_FIELD=bmp_pressure

# -----------------------------------------------------------------------------
# MOCK APP — simulates the SmarKo mobile app on FOCUS network
# INFERENCE_SERVER_URL must point to Laptop 1 (MCS) IP for two-laptop testing.
# -----------------------------------------------------------------------------
INFERENCE_SERVER_URL=http://192.168.1.XX:8001
INFERENCE_API_KEY=changeme

ACC_SENSOR_TYPE=bosch
HARDWARE_ACC_SAMPLE_RATE=50
RESAMPLING_METHOD=linear

POLL_INTERVAL_SECONDS=1
POLL_LOOKBACK_SECONDS=15
MOCK_PATIENT_RESPONSE_TIMEOUT=1
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MQTT BROKER
# Broker runs as the 'mqtt' Docker service — no separate setup needed.
# Reachable from outside Docker at <this-machine-ip>:1883
# Leave username/password blank for no authentication (fine for local testing).
# -----------------------------------------------------------------------------
MQTT_ALERT_TOPIC=fall/alert
MQTT_USERNAME=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# PATIENTS
# Comma-separated patient IDs and MAC addresses (positional mapping).
# Must match the values used in the MCS mock_app .env.
# -----------------------------------------------------------------------------
PATIENT_IDS=patient_test_1
MAC_IDS=6c:1d:eb:04:a9:e6
