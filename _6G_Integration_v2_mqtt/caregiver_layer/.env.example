# =============================================================================
# Fall Detection — Caregiver Layer Environment Variables
# Copy this file to .env and adjust as needed.
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRES (participant_session)
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=fall_pass

# -----------------------------------------------------------------------------
# INFLUXDB (mock FOCUS InfluxDB)
# These values are used both to initialise the InfluxDB container on first start
# AND by fall-dashboard to query fall_events for the fall history tab.
# For two-laptop testing the MCS mock_app also needs these (see README).
# -----------------------------------------------------------------------------
INFLUXDB_ADMIN_PASSWORD=adminpassword
INFLUXDB_TOKEN=mock-focus-token
INFLUXDB_ORG=focus-mock
INFLUXDB_FALL_EVENTS_BUCKET=fall-events

# -----------------------------------------------------------------------------
# MQTT BROKER
# Broker runs as the 'mqtt' Docker service — no separate setup needed.
# Reachable from outside Docker at <this-machine-ip>:1883
# Leave username/password blank for no authentication (fine for local testing).
# -----------------------------------------------------------------------------
MQTT_ALERT_TOPIC=fall/alert
MQTT_USERNAME=
MQTT_PASSWORD=

# -----------------------------------------------------------------------------
# PATIENTS
# Comma-separated patient IDs and MAC addresses (positional mapping).
# Must match the values used in the MCS mock_app .env.
# -----------------------------------------------------------------------------
PATIENT_IDS=sato_helm_test_2
MAC_IDS=6c:1d:eb:04:a9:e6
