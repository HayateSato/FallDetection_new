# =============================================================================
# Fall Detection — Production Environment Variables
# Copy this file to .env and fill in every value marked REQUIRED.
# =============================================================================
#
# Run order reminder:
#   docker compose up -d
#
# Credentials marked CHANGE_ME must be replaced before going live.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Postgres)
# -----------------------------------------------------------------------------
# REQUIRED — password for the fall_detection and mlflow databases.
# Used by: inference-server, fall-dashboard, ml-dashboard, mlflow, db-migrate
POSTGRES_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# INFERENCE SERVER SECURITY
# -----------------------------------------------------------------------------
# REQUIRED — API key that the mobile app (Isa) sends in the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Multiple keys: comma-separated (e.g. key1,key2)
# Share the chosen key with Isa — she puts it in the mobile app config.
API_KEYS=CHANGE_ME

PUBLIC_ENDPOINT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# MINIO (model artifact store)
# -----------------------------------------------------------------------------
# Change from the defaults before exposing port 9000 publicly.
MINIO_USER=CHANGE_ME
MINIO_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# MLFLOW
# -----------------------------------------------------------------------------
MLFLOW_REGISTERED_MODEL=fall-detection-xgboost

# -----------------------------------------------------------------------------
# MQTT BROKER
# The broker runs as the 'mqtt' Docker service -- no separate installation needed.
# MQTT_BROKER_HOST is hardcoded to 'mqtt' in docker-compose.yml (Docker service name).
#
# For local testing: broker is accessible at localhost:1883 from outside Docker.
# For Hetzner: broker is accessible at <server-ip>:1883 (or :8883 for TLS).
# Isa's mobile app connects to this address.
#
# MQTT_USERNAME / MQTT_PASSWORD: only needed if you enable auth in mosquitto.conf.
# Leave blank to run without authentication (fine for local testing).
# -----------------------------------------------------------------------------
MQTT_ALERT_TOPIC=fall/alert
MQTT_USERNAME=
MQTT_PASSWORD=


# -----------------------------------------------------------------------------
# PATIENTS
# Comma-separated patient IDs and their MAC addresses (positional mapping).
# Used by fall-dashboard to map patient names to MAC addresses in the UI.
# Can be left empty if not used.
# -----------------------------------------------------------------------------
PATIENT_IDS=
MAC_IDS=

# -----------------------------------------------------------------------------
# CAREGIVER LAYER (fall-dashboard) — hosted in caregiver_layer/ on FOCUS side
# For two-laptop testing: set to http://<FOCUS_DOMAIN/IP_ADDRESS>:8002
# For single-machine testing: set to http://localhost:8002
# Used by server-health to probe fall-dashboard.
# -----------------------------------------------------------------------------
FALL_DASHBOARD_URL=http://<FOCUS_DOMAIN/IP_ADDRESS>:8002

# -----------------------------------------------------------------------------
# GRAFANA
# -----------------------------------------------------------------------------
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# MODEL
# -----------------------------------------------------------------------------
MODEL_VERSION=v0
ACC_SENSOR_TYPE=bosch
HARDWARE_ACC_SAMPLE_RATE=50
RESAMPLING_METHOD=linear
