{
  "title": "Model Performance",
  "uid": "fall-model-performance",
  "description": "Is the model drifting? Confidence distribution, fall rate trends, and per-version comparison.",
  "tags": ["fall-detection", "model", "drift"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "graphTooltip": 1,

  "templating": {
    "list": [
      {
        "name": "model_version",
        "type": "query",
        "label": "Model Version",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(inference_latency_seconds_count, model_version)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },

  "panels": [

    {
      "id": 1,
      "title": "Fall Detection Rate (last 1h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(fall_detections_total{model_version=~\"$model_version\"}[1h]))",
          "legendFormat": "Falls/hour",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red",    "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 2,
      "title": "Median Fall Confidence (last 5m)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(model_confidence_bucket{model_version=~\"$model_version\", fall_detected=\"true\"}[5m])) by (le))",
          "legendFormat": "Median confidence",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "orange", "value": 0.55 },
              { "color": "yellow", "value": 0.65 },
              { "color": "green",  "value": 0.75 }
            ]
          }
        }
      }
    },

    {
      "id": 3,
      "title": "Low-Confidence Fall Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "description": "Fraction of fall detections with low confidence (<0.60). Rising ratio suggests model drift or noisy sensor data.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(fall_detections_total{model_version=~\"$model_version\", confidence_bucket=\"low\"}[1h])) / clamp_min(sum(increase(fall_detections_total{model_version=~\"$model_version\"}[1h])), 1)",
          "legendFormat": "Low confidence ratio",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.20 },
              { "color": "orange", "value": 0.40 },
              { "color": "red",    "value": 0.60 }
            ]
          }
        }
      }
    },

    {
      "id": 4,
      "title": "Total Predictions (last 24h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(inference_latency_seconds_count{model_version=~\"$model_version\"}[24h]))",
          "legendFormat": "Predictions",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" }
        }
      }
    },

    {
      "id": 5,
      "title": "Fall Detection Rate per Hour",
      "description": "Watch for sudden spikes (sensor noise) or unexpected zeros (connectivity issue).",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model_version) (increase(fall_detections_total{model_version=~\"$model_version\"}[1h]))",
          "legendFormat": "{{model_version}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "drawStyle": "bars",
            "barAlignment": 0
          }
        }
      }
    },

    {
      "id": 6,
      "title": "Fall Confidence Distribution Over Time",
      "description": "Healthy model shows scores near 0 or near 1. Clustering near 0.5 (threshold) signals distribution shift — the model is uncertain, possibly seeing unseen sensor patterns.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(model_confidence_bucket{model_version=~\"$model_version\", fall_detected=\"true\"}[10m])) by (le))",
          "legendFormat": "p95 confidence (falls)",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(model_confidence_bucket{model_version=~\"$model_version\", fall_detected=\"true\"}[10m])) by (le))",
          "legendFormat": "p50 (median) confidence (falls)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(model_confidence_bucket{model_version=~\"$model_version\", fall_detected=\"false\"}[10m])) by (le))",
          "legendFormat": "p50 confidence (non-falls)",
          "refId": "C"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": { "lineWidth": 2 }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "p50 (median) confidence (falls)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
              {
                "id": "custom.thresholdsStyle",
                "value": { "mode": "line" }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "transparent", "value": null },
                    { "color": "red",         "value": 0.4 },
                    { "color": "transparent", "value": 0.65 }
                  ]
                }
              }
            ]
          }
        ]
      }
    },

    {
      "id": 7,
      "title": "Predictions by Model Version",
      "description": "Distribution of inference calls across loaded model versions.",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model_version) (increase(inference_latency_seconds_count[24h]))",
          "legendFormat": "{{model_version}}",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "pieType": "donut",
        "tooltip": { "mode": "single" },
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      }
    },

    {
      "id": 8,
      "title": "Confidence Buckets — Fall Detections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (confidence_bucket) (increase(fall_detections_total{model_version=~\"$model_version\"}[1h]))",
          "legendFormat": "{{confidence_bucket}}",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "barAlignment": 0,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "low" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          }
        ]
      }
    }

  ]
}
