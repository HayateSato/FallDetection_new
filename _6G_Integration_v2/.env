# =============================================================================
# Fall Detection — 6G / Charite Integration
# Single .env shared by:
#   - inference_server/server.py        (the ML inference + FHIR server)
#   - caregiver_client/client.py        (the dashboard + InfluxDB poller)
#
# Each variable is annotated with its owner:
#   SERVER  → read by inference server
#   CLIENT  → read by caregiver client
#   BOTH    → read by both
#
# Run from _6G_Integration/ as working directory:
#   uvicorn inference_server.server:app --host 0.0.0.0 --port 8001
#   python -m caregiver_client.client
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# MODEL  (SERVER — fixed, cannot be changed at runtime)
# v0 = ACC only (16 features)         — no barometer needed (recommended)
# v3 = ACC + barometer (20 features)  — barometer required (not implemented)
# Changing this requires a server restart.
# ─────────────────────────────────────────────────────────────────────────────
MODEL_VERSION=v0                       # SERVER

# ─────────────────────────────────────────────────────────────────────────────
# SENSOR HARDWARE  (BOTH — must agree on both sides)
#   ACC_SENSOR_TYPE         : bosch | non_bosch
#   HARDWARE_ACC_SAMPLE_RATE: physical Hz of the sensor
#   ACC input unit          : always raw LSB integers
# ─────────────────────────────────────────────────────────────────────────────
ACC_SENSOR_TYPE=bosch                   # BOTH
HARDWARE_ACC_SAMPLE_RATE=25             # BOTH
RESAMPLING_METHOD=linear                # SERVER — linear | decimate | average

# ─────────────────────────────────────────────────────────────────────────────
# INFLUXDB  (CLIENT — caregiver client polls InfluxDB for sensor data)
# ─────────────────────────────────────────────────────────────────────────────
INFLUXDB_URL=https://ecosystem-influxdb.smarko-health.de
INFLUXDB_TOKEN=v3vG3RliwQKPhUCYmlu4GAjrQcf0uITn_J2E08FaJdpn1-rNU5j0lSX9Cp9VNKw4i9fRjB6cvSO-euuG5IOnWg==
INFLUXDB_ORG=MCS Datalabs GmbH
INFLUXDB_BUCKET=fd_test
BAROMETER_FIELD=bmp_pressure            # CLIENT — InfluxDB field name for barometer

# ─────────────────────────────────────────────────────────────────────────────
# PATIENTS TO POLL  (CLIENT)
#
# PATIENT_IDS         : comma-separated patient identifiers (FHIR Patient/<id>)
# MAC_IDS  : comma-separated MAC addresses, mapped 1:1 by position to PATIENT_IDS
# INFLUX_PATIENT_TAG  : InfluxDB tag used to identify each patient's records.
#                      Leave empty for single-patient mode (no filter, all rows
#                      go to the first patient ID).
# POLL_INTERVAL_SECONDS : how often the poller cycles through all patients
# POLL_LOOKBACK_SECONDS : how many seconds of recent data to fetch each cycle
# ─────────────────────────────────────────────────────────────────────────────
PATIENT_IDS=test_patient-001         # CLIENT
MAC_IDS=6c:1d:eb:04:a9:e6   # CLIENT
# Leave empty for single-patient demo (no InfluxDB patient filtering)
INFLUX_PATIENT_TAG=
POLL_INTERVAL_SECONDS=10                # CLIENT
POLL_LOOKBACK_SECONDS=15                # CLIENT

# ─────────────────────────────────────────────────────────────────────────────
# CAREGIVER WEB UI  (CLIENT)
# ─────────────────────────────────────────────────────────────────────────────
CAREGIVER_HOST=0.0.0.0                  # CLIENT
CAREGIVER_PORT=8002                     # CLIENT

# ─────────────────────────────────────────────────────────────────────────────
# CAREGIVER DATABASE  (CLIENT)
#
# Defaults to a local SQLite file so the client runs without external services.
# In production point this at Postgres, e.g.
#   DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/caregiver
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./caregiver.db   # CLIENT

# ─────────────────────────────────────────────────────────────────────────────
# REDIS  (BOTH — server publishes fall events, client subscribes for live UI)
#
# If empty, the system still works:
#   - Server simply skips publishing
#   - Dashboard live SSE banner stays disconnected
#   - Fall history is still written by the poller (so the table still updates)
# ─────────────────────────────────────────────────────────────────────────────
# Local: docker run -d --name redis-local -p 6379:6379 redis:7
REDIS_URL=redis://localhost:6379/0
REDIS_FALL_CHANNEL=fall_events          # BOTH

# ─────────────────────────────────────────────────────────────────────────────
# INFERENCE SERVER LOCATION  (CLIENT — where to POST /predict)
# ─────────────────────────────────────────────────────────────────────────────
INFERENCE_SERVER_URL=http://localhost:8001  # CLIENT
INFERENCE_API_KEY=626e6c481b78c77d52db774d0e54a06cefb0553cb245fa15d5c7050fc7424e7a  # CLIENT — must match API_KEYS below

# ─────────────────────────────────────────────────────────────────────────────
# FHIR SERVER  (SERVER — optional auto-push from inference server)
#
# If FHIR_SERVER_URL is set, the inference server POSTs every Observation
# to <FHIR_SERVER_URL>/Observation. The Observation is ALSO returned in the
# /predict response either way, so the client always receives FHIR.
# ─────────────────────────────────────────────────────────────────────────────
# e.g. https://fhir.focus-partner.de/fhir
FHIR_SERVER_URL=
FHIR_BASE_URL=
FHIR_AUTH_TOKEN=
FHIR_PUSH_ON_FALL_ONLY=true             # SERVER

# ─────────────────────────────────────────────────────────────────────────────
# SECURITY  (SERVER)
# ─────────────────────────────────────────────────────────────────────────────
PUBLIC_ENDPOINT_ENABLED=true            # SERVER — require X-API-Key on /predict
API_KEYS=626e6c481b78c77d52db774d0e54a06cefb0553cb245fa15d5c7050fc7424e7a    # SERVER — comma-separated accepted keys
RATE_LIMIT_PER_MINUTE=60                # SERVER — per IP
CORS_ALLOWED_ORIGINS=*                  # SERVER

# ─────────────────────────────────────────────────────────────────────────────
# SERVER PORT
# ─────────────────────────────────────────────────────────────────────────────
SERVER_PORT=8001                        # SERVER
