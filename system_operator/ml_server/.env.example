# ============================================================
# ML Server Environment Variables
# Copy to .env and fill in your values.
# ============================================================

# --- Model ---
MODEL_VERSION=v0                          # v0 | v3 | v5_lsb

# --- Hardware ---
HARDWARE_ACC_SAMPLE_RATE=25               # 25 | 50 | 100
ACC_SENSOR_TYPE=bosch                     # bosch | non_bosch

# --- API Security ---
PUBLIC_ENDPOINT_ENABLED=true
API_KEYS=your-api-key-here                # comma-separated, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RATE_LIMIT_PER_MINUTE=60

# --- Database (Phase 1) ---
DATABASE_URL=postgresql://falldetect:falldetect@localhost:5432/falldetect

# --- Redis (Phase 3) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (shared with caregiver_api) ---
JWT_SECRET_KEY=change-me-to-a-random-secret

# --- Server Port ---
SERVER_PORT=8001
