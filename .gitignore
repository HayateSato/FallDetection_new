# ===========================================================
# Allowlist: track ONLY the folders and files listed below.
# Everything else at root is ignored.
# ===========================================================

/*

# Root files
!.gitignore
!README.md
!system_overview.md

# Active folders
!_6G_integration_v3_docker_focus/
!_6G_integration_v3_docker_mcs/
!_6G_integration_v3_k3s/
!FOCUS_devs_handover/
!isa/
!mohammed/
!__Refactoring_docs/

# Sub-folder exclusions
/isa/OLD/
/mohammed/OLD/

# ===========================================================
# Standard ignores (apply inside tracked folders)
# ===========================================================

# Secrets / environment
**/.env

# Python
**/__pycache__/
**/*.py[cod]

# Logs
**/*.log

# Databases
**/*.db

# Docker image dumps (>100 MB — GitHub rejects)
**/*.tar

# macOS
**/.DS_Store

# Node
**/node_modules/
