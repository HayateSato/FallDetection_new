# Docker Compose env file for caregiver secrets.
# Dollar signs MUST be escaped as $$ here — Docker Compose interpolates $ in env_file values.
# $$ in this file → $ in the container.
#
# To regenerate the hash:
#   python -c "import bcrypt; h=bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode(); print(h)"
# Then replace every $ with $$ before pasting here.
#
# Format: username:$$2b$$12$$<rest_of_hash>
# Multiple users: comma-separated  user1:$$2b$$....,user2:$$2b$$....

CAREGIVER_USERS=test_user:$$2b$$12$$7C6kl6YTiGduXzkcZgVIFOYLN0u5ynJw2eO4YrEy8JpfS5EK1kKr6
