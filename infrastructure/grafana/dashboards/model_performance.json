{
  "title": "Model Performance",
  "description": "Is the model drifting? Confidence score distribution over time.",
  "uid": "fall-model-perf",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Falls Detected per Hour (by model version)",
      "type": "barchart",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "increase(fall_detections_total[1h])",
          "legendFormat": "{{ model_version }} ({{ confidence_bucket }})"
        }
      ]
    },
    {
      "id": 2,
      "title": "Fall Confidence — Median vs p95 over time",
      "description": "A healthy model returns fall confidence > 0.65. If median drops below 0.6, the model may be seeing unfamiliar sensor patterns (distribution shift).",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, rate(model_confidence_bucket{fall_detected=\"true\"}[30m]))",
          "legendFormat": "Median confidence (falls)"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(model_confidence_bucket{fall_detected=\"true\"}[30m]))",
          "legendFormat": "p95 confidence (falls)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "value": 0, "color": "red" },
              { "value": 0.6, "color": "yellow" },
              { "value": 0.75, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Confidence Distribution — All Predictions",
      "description": "A bimodal distribution (peaks near 0 and near 1) is healthy. A distribution clustering near 0.5 suggests model uncertainty.",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.5, rate(model_confidence_bucket[1h]))",
          "legendFormat": "Median confidence (all)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 4,
      "title": "Low-Confidence Fall Ratio",
      "description": "High ratio = many falls detected near the threshold = uncertain model. Target < 0.3.",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "fall_detections_total{confidence_bucket=\"low\"} / (fall_detections_total + 0.001)",
          "legendFormat": "low-confidence ratio"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "thresholds": {
          "steps": [
            { "value": 0, "color": "green" },
            { "value": 0.3, "color": "yellow" },
            { "value": 0.5, "color": "red" }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    },
    {
      "id": 5,
      "title": "Inference Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, rate(inference_latency_seconds_bucket[5m]))",
          "legendFormat": "p50"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, rate(inference_latency_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
