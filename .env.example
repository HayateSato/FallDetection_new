# =============================================================================
# Fall Detection System — Root .env
#
# This single file is loaded by ALL services (Flask client, ML server,
# caregiver API) via config/settings.py.
#
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
#
# Generate secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================


# =============================================================================
# MODEL
# =============================================================================
# Which XGBoost model to load.
# Options with model files on disk: v0, v0_lsb_int, v3, v5_lsb
MODEL_VERSION=v0


# =============================================================================
# HARDWARE / SENSOR
# =============================================================================
# Sensor type determines which InfluxDB field names to read:
#   bosch     → bosch_acc_x / bosch_acc_y / bosch_acc_z
#   non_bosch → acc_x / acc_y / acc_z
ACC_SENSOR_TYPE=bosch

# Hardware accelerometer sampling rate (Hz). Model always runs at 50 Hz.
#   25  → upsampled   (linear interpolation)
#   50  → no resampling
#   100 → downsampled (decimate/average)
HARDWARE_ACC_SAMPLE_RATE=25

# Resampling method
#   Upsampling   (25→50 Hz): linear | cubic | nearest
#   Downsampling (100→50 Hz): decimate | average
RESAMPLING_METHOD=linear

# Barometer (auto-disabled for v0 model)
BAROMETER_FIELD=bmp_pressure
# BAROMETER_ENABLED=true    # uncomment to force-override auto-detection


# =============================================================================
# INFLUXDB
# =============================================================================
# Cloud InfluxDB (fill in your real values)
INFLUXDB_URL=https://your-influxdb-url:8086
INFLUXDB_TOKEN=your-token-here
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=your-bucket

# Local InfluxDB via Docker (infrastructure/docker-compose.yml)
# INFLUXDB_URL=http://localhost:8086
# INFLUXDB_TOKEN=local-dev-token-fall-detection-2024
# INFLUXDB_ORG=fall-detection
# INFLUXDB_BUCKET=fd_test


# =============================================================================
# CONTINUOUS MONITORING
# =============================================================================
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=3       # how often to check for falls (seconds)
MONITORING_LOOKBACK_SECONDS=15      # how far back to query InfluxDB (seconds)


# =============================================================================
# DATA SOURCE
# =============================================================================
# influx = live data from InfluxDB (normal operation)
# csv    = replay a CSV file (validation / offline testing)
DATA_SOURCE=influx

# CSV settings (only used when DATA_SOURCE=csv)
CSV_FILE_PATH=
CSV_WINDOW_INTERVAL_SECONDS=1.0


# =============================================================================
# INFERENCE MODE
# =============================================================================
# local  = run XGBoost on this machine
# remote = send sensor data to the ML server (system_operator/ml_server/)
INFERENCE_MODE=remote

# Only used when INFERENCE_MODE=remote
REMOTE_SERVER_URL=http://localhost:8001
REMOTE_API_KEY=your-api-key-here


# =============================================================================
# ML SERVER (system_operator/ml_server/server.py)
# =============================================================================
SERVER_PORT=8001
PUBLIC_ENDPOINT_ENABLED=true

# Comma-separated API keys. Clients must send one of these in X-API-Key header.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=your-api-key-here

RATE_LIMIT_PER_MINUTE=60
CORS_ALLOWED_ORIGINS=*


# =============================================================================
# DATABASE — PostgreSQL
# =============================================================================
# Stores inference results, feature snapshots, participant sessions.
# Run migrations first: alembic upgrade head
DATABASE_URL=postgresql://falldetect:falldetect@localhost:5432/falldetect


# =============================================================================
# REDIS
# =============================================================================
# Pub/sub broker for fall event fan-out to caregiver and emergency dashboards.
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# JWT — shared by ml_server and caregiver_api
# =============================================================================
# Must be the same value in both services.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-here


# =============================================================================
# FLASK CLIENT (main.py)
# =============================================================================
FLASK_PORT=8000
FLASK_DEBUG=false

# How fall alerts reach the web dashboard
#   sse     = real-time (works on localhost)
#   polling = polls every N seconds (use if SSE doesn't work through a tunnel)
NOTIFICATION_MODE=sse
POLLING_INTERVAL_SECONDS=3

# CSV export
FALL_DATA_EXPORT_ENABLED=true
FALL_DATA_EXPORT_DIR=results/

# Timezone offset from UTC for CSV filenames (e.g. 2 = CEST, 1 = CET, 0 = UTC)
TIMEZONE_OFFSET_HOURS=2


# =============================================================================
# CAREGIVER USERS (caregiver/api/server.py)
# =============================================================================
# Format: username:bcrypt_hash,username2:bcrypt_hash2
# Generate hash: python -c "from shared.auth.jwt_utils import hash_password; print(hash_password('mypassword'))"
CAREGIVER_USERS=
