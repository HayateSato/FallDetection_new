# Caregiver user credentials for Docker Compose - Docker Compose interpolates $VAR syntax inside env files, so bcrypt hashes need $$ to escape each $
# (when running locally/via python, credentials in caregiver/api/.env are used instead  -- Python reads it directly — single $ is fine)


# Format:  CAREGIVER_USERS=username:bcrypt_hash,username2:bcrypt_hash2
# IMPORTANT: bcrypt hashes contain '$' — escape them as '$$' in this file
#            so Docker Compose interpolation doesn't eat them.
#
# Generate a hash (run from project root):
#   python -c "from shared.auth.jwt_utils import hash_password; print(hash_password('yourpassword'))"
# Then replace every '$' with '$$' before pasting here.
#
# Example (password = "secret"):
#   CAREGIVER_USERS=alice:$$2b$$12$$abc...xyz



# --- Users (username:bcrypt_hash, comma-separated) ---
#  test_user - mypassword123
# Generate hash: python -c "from shared.auth.jwt_utils import hash_password; print(hash_password('mypassword'))"
CAREGIVER_USERS=test_user:$$2b$$12$$7C6kl6YTiGduXzkcZgVIFOYLN0u5ynJw2eO4YrEy8JpfS5EK1kKr6
