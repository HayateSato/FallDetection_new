# ============================================================
# Caregiver API Environment Variables
# ============================================================

# --- Database (read-only from ml_server's Postgres) ---
DATABASE_URL=postgresql://falldetect:falldetect@localhost:5432/falldetect

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT (must match ml_server JWT_SECRET_KEY) ---
JWT_SECRET_KEY=change-me-to-a-random-secret

# --- Users (username:bcrypt_hash, comma-separated) ---
# Generate hash: python -c "from shared.auth.jwt_utils import hash_password; print(hash_password('mypassword'))"
CAREGIVER_USERS=alice:$2b$12$...,bob:$2b$12$...

# --- Port ---
CAREGIVER_API_PORT=8002
