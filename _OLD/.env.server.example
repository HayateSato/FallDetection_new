# =============================================================================
# FALL DETECTION API SERVER CONFIGURATION
# =============================================================================
# Copy this file to .env on the server machine:
#   cp .env.server.example .env
#
# Then run:
#   python server.py
# =============================================================================

# =============================================================================
# MODEL SELECTION
# =============================================================================
# Available models (must have corresponding files in model/ directory):
#   v0:        ACC only (16 features) - no barometer needed
#   v0_lsb_int: ACC only (16 features) - raw LSB integers
#   v3:        ACC + BARO (20 features) - BEST model
#   v5_lsb:    Raw features (22 features) - LSB integers
MODEL_VERSION=v0

# =============================================================================
# SENSOR CONFIGURATION
# =============================================================================
# Sensor type: 'bosch' or 'non_bosch'
ACC_SENSOR_TYPE=bosch

# Hardware sampling rate of the data the client sends (Hz)
# The server will resample to 50Hz if needed.
#   25  -> upsampled to 50Hz
#   50  -> no resampling
#   100 -> downsampled to 50Hz
HARDWARE_ACC_SAMPLE_RATE=25

# Resampling method:
#   Upsampling (25->50):   'linear' (recommended), 'cubic', 'nearest'
#   Downsampling (100->50): 'decimate', 'average'
RESAMPLING_METHOD=linear

# Barometer sampling rate (Hz) - only relevant for models that use barometer
BAROMETER_SAMPLING_RATE=25

# =============================================================================
# SERVER SETTINGS
# =============================================================================
# Port the API server listens on
SERVER_PORT=8000

# =============================================================================
# API SECURITY (optional but recommended for public exposure)
# =============================================================================
# Set to true to require API key authentication
PUBLIC_ENDPOINT_ENABLED=false

# API keys (comma-separated). Share with authorized clients.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=

# Rate limit: max requests per minute per IP
RATE_LIMIT_PER_MINUTE=30

# CORS allowed origins (* for all, or comma-separated URLs)
CORS_ALLOWED_ORIGINS=*
